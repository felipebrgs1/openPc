# ============================================================
# OpenPC — variáveis de produção (M5)
# Copie para deploy/.env e preencha. NUNCA commite o .env real.
#   cp deploy/.env.example deploy/.env
# ============================================================

# Domínio público (TLS automático via Caddy/Let's Encrypt)
DOMAIN=openpc.example.com

# Senha do Postgres (produção — troque!)
POSTGRES_PASSWORD=troque-esta-senha

# Tag das imagens no GHCR (default: latest; deploy por tag usa a tag do git)
IMAGE_TAG=latest

# Origem CORS permitida (opcional — o front é same-origin via Caddy,
# então deixe vazio em produção)
CORS_ALLOWED_ORIGINS=

# Webhook de alerta de scraper quebrado (ex: Slack/Discord/ntfy).
# Vazio = sem envio (apenas log).
ALERTS_WEBHOOK_URL=

# Backup — retenção local em dias
BACKUP_KEEP_DAYS=14

# Backup off-site via rclone/S3. Deixe RCLONE_REMOTE vazio para desativar.
# Exemplo: RCLONE_REMOTE=s3:openpc-backups
RCLONE_REMOTE=
RCLONE_S3_ACCESS_KEY_ID=
RCLONE_S3_SECRET_ACCESS_KEY=
RCLONE_S3_REGION=sa-east-1
RCLONE_S3_ENDPOINT=
